# Lantern reads these from the environment. All are optional. Never commit a filled-in .env.

# Model keys (only for the provider you use; you can also paste a key in the app's Settings)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Key for an `openai-compatible` endpoint (lantern/providers.py)
LANTERN_API_KEY=

# Where `lantern serve` keeps projects, settings, and remembered keys (default ~/.lantern)
LANTERN_HOME=
# Extra Host header to accept when serving beyond localhost, e.g. mybox.local:8765 (lantern/server.py)
LANTERN_ALLOWED_HOST=
# Set to 1 to log each HTTP request from `lantern serve`
LANTERN_DEBUG=
