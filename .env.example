# Lantern reads these from the environment. All are optional. Never commit a filled-in .env.

# Model keys (only for the provider you use; you can also paste a key in the app's Settings)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Key for an `openai-compatible` endpoint (lantern/providers.py)
LANTERN_API_KEY=

# The free-allowance gateway (gateway/, deployed on Fly; never set on a tester's computer)
# Where the gateway sends Anthropic requests (default https://api.anthropic.com)
ANTHROPIC_URL=
# Sign in with GitHub / Google: the OAuth app ids and secrets (docs/deploy.md)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where `lantern serve` keeps projects, settings, and remembered keys (default ~/.lantern)
LANTERN_HOME=
# Extra Host header to accept when serving beyond localhost, e.g. mybox.local:8765 (lantern/server.py)
LANTERN_ALLOWED_HOST=
# Set to 1 to log each HTTP request from `lantern serve`
LANTERN_DEBUG=
# Set to 1 to skip the dependency audits (pip-audit, npm audit), the only network calls `lantern analyze` makes
LANTERN_OFFLINE=
# Set to 1 to agree to send code to a hosted model without the consent prompt (CI and scripts only)
LANTERN_ACCEPT_DATA_SHARING=
# Model for `lantern explain`, as provider/name (default anthropic/claude-haiku-5-5)
LANTERN_MODEL=
# The free-allowance gateway the app and CLI use without an own key (default https://lantern-gateway.fly.dev)
LANTERN_GATEWAY_URL=
# Allowance token for one run (the cloud service hands it to `lantern explain`; the CLI keeps it in LANTERN_HOME)
LANTERN_TOKEN=
# Where the consent record lives (default XDG_CONFIG_HOME or ~/.config)
LANTERN_CONFIG_DIR=
XDG_CONFIG_HOME=
# Repository links: extra git hosts (host or host:port) beyond the public forges, and the clone size cap in MB (500)
LANTERN_GIT_HOSTS=
LANTERN_CLONE_MAX_MB=
# git's own variable, honoured the way git honours it (lantern/gitfacts.py finds a folder's repository by hand, so it
# has to): folders above which nobody looks for the repository a folder belongs to. Only the cloud service sets it,
# for its own steps: a run's commit is never taken from a folder above the run's code.
# GIT_CEILING_DIRECTORIES=
# Read the way git reads it, and for root only: the user `sudo` came from, whose git folders above an analyzed folder
# then count as the current user's own (lantern/gitfacts.py). sudo sets it; never set it by hand.
# SUDO_UID=
# The search path of the person's own shell, read to find the programs Lantern starts (git, npm, pip-audit, gitleaks,
# docker, tesseract; lantern/programs.py): only the folders PATH names in full are looked in, never the current
# folder, and on Windows PATHEXT says which endings can be started. The system sets both; nothing to set for Lantern.
# PATH=   PATHEXT=
# Test sandbox: force a backend (subprocess|docker); folders the sandboxed tests may write; extra site-packages
LANTERN_SANDBOX=
LANTERN_SANDBOX_WRITABLE=
LANTERN_SANDBOX_SITE=
# Set by the sandbox itself for the programs it starts, never by a person: "required" (a project's tests do not run
# unless the guard against writes and network connections is loaded) or "expected" (a cloud step says so in its log)
LANTERN_SANDBOX_GUARD=
# Dependency audits computed earlier (a JSON file), used by the cloud worker's jailed analysis
LANTERN_AUDITS_FROM=

# --- gateway/ (the free allowance; set on Fly, never on a tester's computer) ---
# Which provider answers first (anthropic|deepseek), the models, DeepSeek's URL
LANTERN_PRIMARY=
LANTERN_ANTHROPIC_MODEL=
UPSTREAM_URL=
LANTERN_MODEL_ID=
# Where the gateway is reached, the HMAC secret for sign-in state, the SQLite file, the admin dashboard secret
LANTERN_PUBLIC_URL=
LANTERN_AUTH_SECRET=
LANTERN_DB=
LANTERN_ADMIN_SECRET=

# --- cloud/ (lantern-cloud; set on Fly) ---
LANTERN_CLOUD_DB=
LANTERN_CLOUD_RESULTS=
LANTERN_CLOUD_WORK=
LANTERN_CLOUD_UPLOADS=
LANTERN_CLOUD_RUNS_PER_DAY=
LANTERN_CLOUD_GLOBAL_RUNS_PER_DAY=
LANTERN_CLOUD_ACTIVE_PER_USER=
LANTERN_CLOUD_CONCURRENT_JOBS=
LANTERN_CLOUD_JOB_SECONDS=
LANTERN_CLOUD_IDLE_MINUTES=
LANTERN_CLOUD_IDENTITY_TTL=
LANTERN_CLOUD_RETENTION_DAYS=
LANTERN_CLOUD_HOSTS=
LANTERN_CLOUD_AUDITS=
LANTERN_CLOUD_VIEW_SECRET=
LANTERN_CLOUD_VIEW_MINUTES=
# Set by the worker inside a cloud run (the Evidence report says "analyzed in the cloud")
LANTERN_CLOUD_RUN=
# Connect GitHub (optional): the GitHub App's id, private key (PEM text), and short name
LANTERN_GITHUB_APP_ID=
LANTERN_GITHUB_APP_KEY=
LANTERN_GITHUB_APP_SLUG=

# LANTERN_SIGNUPS_PER_DAY=200   # gateway: new accounts per UTC day (0 = no cap)
# What anybody can send the gateway without signing in (gateway/README.md, "What anybody can send"):
# LANTERN_INSTALLS_PER_DAY=1000         # new installs the opt-in usage reports may add per UTC day, everyone together (0 = no cap)
# LANTERN_SENDER_INSTALLS_PER_DAY=50    # new installs one sender may add in a day (0 = no limit)
# LANTERN_SENDER_PINGS_PER_HOUR=300     # usage reports one sender may send in an hour (0 = no limit)
# LANTERN_ADDRESS_HEADER=fly-client-ip  # the header the gateway's proxy writes the caller's address in (nothing = the connection's address)
# LANTERN_HOME_URL=https://lantern-cloud.fly.dev/   # gateway: where the logo on its sign-in pages links (https only)

# Tests and benchmarks (tools/netguard/, tools/netless.py, bench/live.py)
# Set to 1 to switch real model providers off: only a model on this computer may answer, anything else is refused
# with a plain error and nothing is sent. Every test and benchmark run sets it; it is never set for a live run.
LANTERN_NO_REAL_PROVIDERS=
# Set by a guarded run itself, never by hand: the file refused network attempts are written to, the host names a
# benchmark declared, and the ports of forwarding proxies on this computer that must not be used.
# LANTERN_NETGUARD_LOG=   LANTERN_NETGUARD_ALLOW=   LANTERN_NETGUARD_DENY=
# CI sets this to `required`: the tests then refuse to start unless the operating system gave the run a network with
# no route to the outside (python tools/netless.py -- python -m pytest).
# LANTERN_TESTS_NETLESS=required
# tools/netless.py, started with sudo, runs the command as the calling user: it reads SUDO_UID and SUDO_GID (sudo
# sets them) and sets USER and LOGNAME for the command.

# Browser smoke tests (tools/viewer_smoke.js, tools/cloud_site_smoke.js): which Playwright engine; chromium (default),
# firefox or webkit (Safari's engine). CI runs all three (LANTERN_BROWSERS in tools/audit.sh).
# PW_BROWSER=chromium
