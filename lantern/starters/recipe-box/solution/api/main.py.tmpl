"""Recipe Box API: save recipes, import them from a web page, attach a photo."""
import os
import re
from pathlib import Path
from urllib.parse import urlparse

import httpx
from fastapi import FastAPI, HTTPException, UploadFile
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel

from . import db

app = FastAPI(title="Recipe Box")
# Only our own frontend may call the API from a browser.
FRONTEND_ORIGINS = os.environ.get("FRONTEND_ORIGINS", "http://localhost:5173").split(",")
app.add_middleware(CORSMiddleware, allow_origins=FRONTEND_ORIGINS, allow_methods=["GET", "POST"],
                   allow_headers=["Content-Type"])
db.init()
PHOTOS = Path("photos")
MAX_PHOTO_BYTES = 5 * 1024 * 1024
PHOTO_TYPES = {"image/jpeg": ".jpg", "image/png": ".png", "image/webp": ".webp"}
# The import button may only fetch pages from these sites, never internal addresses.
ALLOWED_HOSTS = {"www.bbcgoodfood.com", "www.allrecipes.com", "cooking.nytimes.com"}


@app.middleware("http")
async def security_headers(request, call_next):
    response = await call_next(request)
    response.headers["X-Content-Type-Options"] = "nosniff"
    response.headers["X-Frame-Options"] = "DENY"
    response.headers["Content-Security-Policy"] = "default-src 'none'; frame-ancestors 'none'"
    return response


class NewRecipe(BaseModel):
    title: str
    servings: int = 2
    instructions: str


class ImportRequest(BaseModel):
    url: str


class SuggestRequest(BaseModel):
    ingredients: str


@app.get("/api/recipes")
def list_recipes():
    return db.all_recipes()


@app.get("/api/recipes/{recipe_id}")
def read_recipe(recipe_id: int):
    recipe = db.get_recipe(recipe_id)
    if recipe is None:
        raise HTTPException(status_code=404, detail="No such recipe")
    return recipe


@app.post("/api/recipes")
def create_recipe(recipe: NewRecipe):
    return {"id": db.add_recipe(recipe.title, recipe.servings, recipe.instructions)}


@app.post("/api/recipes/import")
def import_recipe(req: ImportRequest):
    page = fetch_page(req.url)
    title = re.search(r"<title>(.*?)</title>", page, re.S)
    return {"id": db.add_recipe(title.group(1).strip() if title else req.url, 2, page[:5000])}


@app.post("/api/recipes/{recipe_id}/photo")
async def upload_photo(recipe_id: int, file: UploadFile):
    ext = PHOTO_TYPES.get(file.content_type or "")
    if ext is None:
        raise HTTPException(status_code=400, detail="Photos must be JPEG, PNG or WebP")
    data = await file.read(MAX_PHOTO_BYTES + 1)
    if len(data) > MAX_PHOTO_BYTES:
        raise HTTPException(status_code=413, detail="Photos must be 5 MB or smaller")
    PHOTOS.mkdir(exist_ok=True)
    name = f"recipe-{recipe_id}{ext}"   # our own name, never the uploader's
    (PHOTOS / name).write_bytes(data)
    db.set_photo(recipe_id, name)
    return {"ok": True}


@app.post("/api/suggest")
def suggest(req: SuggestRequest):
    """The OpenAI key stays on the server; the browser only ever talks to us."""
    res = httpx.post(
        "https://api.openai.com/v1/chat/completions",
        headers={"Authorization": f"Bearer {os.environ['OPENAI_API_KEY']}"},
        json={"model": "gpt-4o-mini",
              "messages": [{"role": "user", "content": f"Suggest a short recipe using: {req.ingredients[:200]}"}]},
        timeout=30,
    )
    return {"text": res.json()["choices"][0]["message"]["content"]}


def fetch_page(url):
    parts = urlparse(url)
    if parts.scheme != "https" or parts.hostname not in ALLOWED_HOSTS:
        raise HTTPException(status_code=400, detail="Recipes can only be imported from: " + ", ".join(sorted(ALLOWED_HOSTS)))
    return httpx.get(url, follow_redirects=False, timeout=10).text
