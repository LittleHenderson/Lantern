import { useEffect, useState } from "react"
import { useParams } from "react-router-dom"
import { getRecipe, uploadPhoto, type Recipe } from "../api"

export default function RecipePage() {
  const { id = "" } = useParams()
  const [recipe, setRecipe] = useState<Recipe | null>(null)
  const [scale, setScale] = useState("1")

  useEffect(() => { getRecipe(id).then(setRecipe) }, [id])

  async function onPhoto(e: React.ChangeEvent<HTMLInputElement>) {
    if (recipe && e.target.files?.[0]) await uploadPhoto(recipe.id, e.target.files[0])
  }

  if (!recipe) return <p>Loading...</p>
  // "Scale" accepts a plain number like 2 or 1.5. Never run what someone typed as code.
  const factor = Number(scale)
  const servings = Number.isFinite(factor) && factor > 0 ? recipe.servings * factor : recipe.servings
  return (
    <article>
      <h1>{recipe.title}</h1>
      <label>Scale: <input value={scale} onChange={(e) => setScale(e.target.value)} /></label>
      <p>Serves {servings}</p>
      <div style={{ whiteSpace: "pre-wrap" }}>{recipe.instructions}</div>
      <label>Add a photo: <input type="file" accept="image/*" onChange={onPhoto} /></label>
    </article>
  )
}
