import dns from "node:dns/promises"
import { BlockList } from "node:net"

// Addresses a link must never lead to: this computer, the local network and the cloud's own settings service.
const inside = new BlockList()
inside.addSubnet("127.0.0.0", 8, "ipv4")
inside.addSubnet("10.0.0.0", 8, "ipv4")
inside.addSubnet("172.16.0.0", 12, "ipv4")
inside.addSubnet("192.168.0.0", 16, "ipv4")
inside.addSubnet("169.254.0.0", 16, "ipv4")
inside.addSubnet("0.0.0.0", 8, "ipv4")
inside.addAddress("::1", "ipv6")
inside.addSubnet("fc00::", 7, "ipv6")
inside.addSubnet("fe80::", 10, "ipv6")

// Any name can point at an inside address, so look the name up and ask about the address it leads to.
async function isOutside(url) {
  if (!/^https?:\/\//.test(url)) return false
  try {
    const { address, family } = await dns.lookup(new URL(url).hostname)
    return !inside.check(address, family === 6 ? "ipv6" : "ipv4")
  } catch {
    return false
  }
}

// Is the link alive? Ask for it directly instead of building a shell command.
// A redirect is not followed (it could lead inside after the check); it still counts as alive.
export async function isAlive(url) {
  if (!(await isOutside(url))) return false
  try {
    const res = await fetch(new URL(url), { method: "HEAD", redirect: "manual", signal: AbortSignal.timeout(5000) })
    return res.ok || (res.status >= 300 && res.status < 400)
  } catch {
    return false
  }
}

export async function fetchTitle(url) {
  if (!(await isOutside(url))) return url
  try {
    const res = await fetch(new URL(url), { redirect: "manual", signal: AbortSignal.timeout(5000) })
    const html = await res.text()
    return (html.match(/<title>(.*?)<\/title>/) || [])[1] || url
  } catch {
    return url
  }
}
