<title>Book a bike - Ridgeline Bikes</title>
<link rel="stylesheet" href="css/site.css">
</head>
<body>
<header class="top">
<a class="brand" href="index.html"><img src="img/logo.svg" alt="Ridgeline Bikes, home" width="40" height="40"></a>
<nav aria-label="Main">
<a href="index.html">Home</a>
