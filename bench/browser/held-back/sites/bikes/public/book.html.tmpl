</nav>
</header>
<main>
<h1>Book a bike</h1>
<p>Pick a day and a bike; we keep it for you until ten in the morning.</p>
<form id="booking" action="booked.html" method="get">
<p><label for="name">Your name</label> <input id="name" name="name" autocomplete="name"></p>
<p><label for="tel">Phone</label> <input id="tel" name="tel" type="tel" autocomplete="tel"></p>
<p><label for="day">Day</label> <input id="day" name="day" type="date"></p>
<p><label for="bike">Bike</label> <select id="bike" name="bike"><option value="road">Road</option><option value="gravel">Gravel</option><option value="electric">Electric</option></select></p>
<p><label for="notes">Anything we should know</label><br><textarea id="notes" name="notes" rows="3" cols="40"></textarea></p>
<p><button type="submit">Book the bike</button></p>
</form>
<p><a href="terms.html">Read the rental terms</a></p>
</main>
<script src="js/site.js"></script>
</body>
</html>
