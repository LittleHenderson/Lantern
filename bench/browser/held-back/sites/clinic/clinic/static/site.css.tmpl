:root { --ink: #1b2733; --paper: #f7f9fb; --accent: #1d6fa5; --soft: #e3eef6; }
[hidden] { display: none !important; }
* { box-sizing: border-box; }
body { margin: 0; font-family: "Segoe UI", Roboto, Arial, sans-serif; color: var(--ink); background: var(--paper); line-height: 1.5; }
.top { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; padding: .75rem 1.25rem; background: #fff; border-bottom: 1px solid #c9d6e0; }
.brand { font-weight: bold; color: var(--accent); text-decoration: none; }
.top nav a { color: var(--accent); margin-right: .75rem; }
main { max-width: 44rem; margin: 0 auto; padding: 1rem 1.25rem 2rem; }
.notice { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .5rem 1rem; background: var(--soft); border-radius: 6px; }
.close { display: inline-flex; padding: .35rem; border: 0; border-radius: 4px; background: transparent; color: var(--ink); cursor: pointer; }
button { font: inherit; padding: .45rem 1rem; border: 1px solid var(--accent); border-radius: 6px; background: #fff; color: var(--accent); cursor: pointer; }
button[type="submit"] { background: var(--accent); color: #fff; }
.topics { display: flex; gap: .5rem; margin: 1rem 0; }
.topic.chosen { background: var(--accent); color: #fff; }
input, select, textarea { font: inherit; padding: .35rem .5rem; border: 1px solid #8796a3; border-radius: 4px; }
.error { color: #a12622; }
:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
