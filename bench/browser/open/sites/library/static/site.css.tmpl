body { font-family: "Trebuchet MS", sans-serif; margin: 0; color: #1d2433; background: #ffffff; line-height: 1.5; }
header { display: flex; align-items: center; gap: 1rem; background: #12355b; padding: 0.5rem 1.5rem; }
header nav a { color: #ffffff; margin-right: 0.75rem; }
main { max-width: 44rem; margin: 1.5rem auto; padding: 0 1rem; }
table { border-collapse: collapse; width: 100%; }
th, td { border-bottom: 1px solid #d5dbe5; padding: 0.3rem 0.5rem; text-align: left; }
form p { margin: 0.5rem 0; }
label { display: inline-block; min-width: 9rem; }
.search { margin: 1rem 0; }
