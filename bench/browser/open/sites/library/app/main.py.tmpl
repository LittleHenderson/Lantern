"""The app: its pages, its files, and what every answer carries."""
import secrets
from pathlib import Path

from fastapi import FastAPI, Request
from fastapi.staticfiles import StaticFiles

from . import account, catalogue, suggest

app = FastAPI(title="Riverside Library")
app.mount("/static", StaticFiles(directory=Path(__file__).resolve().parent.parent / "static"), name="static")
app.include_router(catalogue.router)
app.include_router(account.router)
app.include_router(suggest.router)


@app.middleware("http")
async def every_answer(request: Request, call_next):
    response = await call_next(request)
    response.headers["Content-Security-Policy"] = "default-src 'self'"
    response.headers["X-Frame-Options"] = "DENY"
    response.headers["X-Content-Type-Options"] = "nosniff"
    response.headers["Referrer-Policy"] = "same-origin"
    if "sid" not in request.cookies:
        response.set_cookie("sid", secrets.token_urlsafe(24), httponly=True, samesite="lax")
    return response
