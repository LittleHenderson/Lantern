body{font-family:system-ui,sans-serif;margin:0;background:#f6f7fb;color:#1c2030}header{background:#3b4cca;color:#fff;padding:.75rem 1.5rem}header h1{margin:0 0 .25rem;font-size:1.4rem}nav a{color:#fff;margin-right:1rem}main{max-width:36rem;margin:1.5rem auto;padding:0 1rem}.tasks{list-style:none;padding:0}.task{background:#fff;border:1px solid #d7dbee;border-radius:6px;margin-bottom:.5rem;padding:.5rem .75rem}.task .title{margin-right:.75rem}.task button{float:right}.note{margin:.25rem 0 0;color:#5a6075;font-size:.9rem}#add{margin-top:1rem}#add label{display:block;margin-bottom:.25rem}#add input{padding:.25rem;margin-right:.5rem}body.compact .task{padding:.25rem .5rem}
