body { font-family: Georgia, serif; margin: 0; color: #1f2a1f; background: #fbfaf5; line-height: 1.5; }
header { background: #2f6b2f; padding: 0.75rem 1.5rem; }
nav a { color: #fff; margin-right: 1rem; }
main { max-width: 40rem; margin: 1.5rem auto; padding: 0 1rem; }
footer { max-width: 40rem; margin: 2rem auto; padding: 0 1rem; font-size: 0.9rem; }
table { border-collapse: collapse; }
th, td { border-bottom: 1px solid #c9d6c3; padding: 0.25rem 0.75rem; text-align: left; }
.events li { margin-bottom: 0.5rem; }
.when { font-weight: bold; margin-right: 0.5rem; }
.note { margin-left: 0.5rem; color: #2f6b2f; }
button { font: inherit; }
