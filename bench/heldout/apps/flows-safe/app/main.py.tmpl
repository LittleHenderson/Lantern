"""The same flows, safe side: fixed SQL text, parameters, an allow-list, a path check, an owner filter, a rate
limiter on login, and the admin check before the action (no shell)."""
import shutil
import subprocess
import tempfile

from fastapi import Depends, FastAPI, Request, UploadFile
from slowapi import Limiter
from slowapi.util import get_remote_address

from . import files, helpers, service
from .auth import current_user, require_admin

app = FastAPI()
limiter = Limiter(key_func=get_remote_address)
app.state.limiter = limiter


@app.get("/items/search")
def search(sort: str = "id"):
    return service.list_items(helpers.validate_sort(sort))


@app.get("/items/by-name")
def by_name(name: str):
    return service.find_by_name(name)


@app.get("/preview")
def preview(url: str):
    return helpers.fetch_page(url)


@app.post("/import")
def import_archive(upload: UploadFile):
    tmp = tempfile.mkdtemp()
    path = f"{tmp}/upload.zip"
    with open(path, "wb") as out:
        shutil.copyfileobj(upload.file, out)
    return files.extract_upload(path, tmp)


@app.get("/notes/{note_id}")
def note(note_id: int, user: dict = Depends(current_user)):
    return service.get_note(note_id, user["id"])


@app.post("/login")
@limiter.limit("5/minute")
def login(request: Request, username: str, password: str):
    return {"ok": username == "admin" and password == "admin"}


@app.post("/admin/run")
def admin_run(path: str, user: dict = Depends(current_user)):
    require_admin(user)
    result = subprocess.run(["ls", "-l", "--", path], capture_output=True, text=True)
    return {"out": result.stdout}
