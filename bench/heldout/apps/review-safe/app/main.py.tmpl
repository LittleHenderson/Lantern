"""The safe twins of the review's examples: the same binding shapes, but what replaces the fixed text is another
fixed string. These queries splice only fixed text and must stay low, never high."""
from fastapi import FastAPI

from .db import conn

app = FastAPI()


@app.get("/rows-match")
def rows_match(payload: dict):
    order = "id"
    match payload.get("order"):
        case "name":
            order = "name"
    return conn.execute(f"SELECT * FROM items ORDER BY {order}")


@app.get("/rows-except")
def rows_except(text: str):
    order = "id"
    try:
        int(text)
    except ValueError:
        order = "name"
    return conn.execute(f"SELECT * FROM items ORDER BY {order}")


@app.get("/rows-nonlocal")
def rows_nonlocal(text: str):
    order = "id"

    def replace():
        nonlocal order
        order = "name"

    replace()
    return conn.execute(f"SELECT * FROM items ORDER BY {order}")


ORDER = "id"


@app.get("/rows-global")
def rows_global(text: str):
    def replace():
        global ORDER
        ORDER = "name"

    replace()
    return conn.execute(f"SELECT * FROM items ORDER BY {ORDER}")
