"""The fifth example: a repo function named `list` shadows the built-in. `out.append` must link to Box.append."""


class Box:
    def __init__(self):
        self.items = []

    def append(self, value):
        self.items.append(value)
        return value


def list() -> Box:
    return Box()


def run():
    out = list()
    out.append(1)
    return out
