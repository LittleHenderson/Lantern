var execFile = require('child_process').execFile
var db = require('./db')

var NEXT_PAGES = { home: '/', items: '/items' }

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
  })
}

// the caller's words travel as a parameter, never as query text
module.exports.search = function (req, res) {
  db.query('SELECT id, name FROM items WHERE name = ?', [req.query.q], function (err, rows) {
    if (err) return res.status(500).end()
    res.send('<h1>Results for ' + escapeHtml(req.query.q) + '</h1>' + JSON.stringify(rows))
  })
}

module.exports.ping = function (req, res) {
  execFile('ping', ['-c', '1', '--', String(req.body.host)], function (err, stdout) {
    res.send(stdout)
  })
}

module.exports.go = function (req, res) {
  var target = NEXT_PAGES[req.query.next] || '/'
  res.redirect(target)
}

module.exports.remove = function (req, res) {
  db.query('DELETE FROM items WHERE id = ?', [req.params.id], function () {
    res.status(204).end()
  })
}
